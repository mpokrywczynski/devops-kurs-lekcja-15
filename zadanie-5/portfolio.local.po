server {
    listen 80;
    server_name portfolio.local;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name portfolio.local;

    ssl_certificate     /etc/nginx/ssl/portfolio.local-fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/portfolio.local.key;

    # profil intermediate (TLS 1.2 + 1.3)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS etapami: 300 s -> 86400 s
    add_header Strict-Transport-Security "max-age=86400" always;

    root /var/www/portfolio.local;
    index index.html;

    access_log /var/log/nginx/portfolio.access.log combined buffer=64k flush=5s;
    error_log /var/log/nginx/portfolio.error.log;

    # Zadanie 2: własne strony błędów
    error_page 404 /bledy/404.html;
    error_page 500 502 503 504 /bledy/50x.html;

    location = /bledy/404.html {
        internal;
    }

    location = /bledy/50x.html {
        internal;
    }

    # Tylko do pokazania strony 50x
    location = /test-500 {
        return 500;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Zadanie 3: wykaz plików tylko w /pobierz/
    # autoindex on w produkcji to wyciek informacji
    # Wykaz katalogu ujawnia nazwy wszystkich plików — łącznie z kopiami zapasowymi,
    #archiwami wdrożeń i plikami, o których zapomniano.
    location /pobierz/ {
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
    }
}
