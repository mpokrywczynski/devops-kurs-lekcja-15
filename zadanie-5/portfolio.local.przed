server {
    listen 80;
    server_name portfolio.local;

    root /var/www/portfolio.local;
    index index.html;

    access_log /var/log/nginx/portfolio.access.log combined buffer=64k flush=5s;
    error_log /var/log/nginx/portfolio.error.log;

    # Zadanie 2: własne strony błędów
    error_page 404 /bledy/404.html;
    error_page 500 502 503 504 /bledy/50x.html;

    location = /bledy/404.html {
        internal;
    }

    location = /bledy/50x.html {
        internal;
    }

    # Tylko do pokazania strony 50x
    location = /test-500 {
        return 500;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Zadanie 3: wykaz plików tylko w /pobierz/
    # autoindex on w produkcji to wyciek informacji
    # Wykaz katalogu ujawnia nazwy wszystkich plików — łącznie z kopiami zapasowymi,
    #archiwami wdrożeń i plikami, o których zapomniano.
    location /pobierz/ {
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
    }
}
